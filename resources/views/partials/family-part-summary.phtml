<?php

use Hartenthaler\Webtrees\Module\ExtendedFamily\Presentation\FamilyPartSummaryPresenter;

/**
 * @var object $extfam_obj
 * @var object $filterObj
 * @var string $filterOption
 * @var string $propName
 * @var string $summaryName
 */

$summaryLines = (new FamilyPartSummaryPresenter())->summaryLines($extfam_obj, $filterObj, $filterOption, $propName, $summaryName);
$showProbandLabels = in_array($propName, ['parents', 'siblings'], true);

?>

                            <div id="hh-extended-family-summary">
                                <?php foreach ($summaryLines as $summaryLine): ?>
                                    <h3><?= $summaryLine ?></h3>
                                <?php endforeach ?>

                                <?php if ($showProbandLabels && $extfam_obj->config->showLabels && $extfam_obj->proband->labels): ?>
                                    <?php foreach ($extfam_obj->proband->labels as $label): ?>
                                        <span class="hh_extended_family_label"><?= $label ?></span>&nbsp;
                                    <?php endforeach ?>
                                <?php endif ?>

                                <?php if ($propName == 'parents' && $extfam_obj->config->showSosaNumbers && $extfam_obj->proband->sosaLabels): ?>
                                    <?php foreach ($extfam_obj->proband->sosaLabels as $label): ?>
                                        <span class="hh_extended_family_label"><?= $label ?></span>&nbsp;
                                    <?php endforeach ?>
                                <?php endif ?>
                            </div>
