<?php

use Fisharebest\Webtrees\View;

/**
 * @var string $extended_family_css used in JavaScript code as a link to the CSS file
 */
?>

<?php View::push('javascript') ?>
<script>
  // stylesheet
  var newSheet = document.createElement("link");
  newSheet.setAttribute("rel","stylesheet");
  newSheet.setAttribute("type","text/css");
  newSheet.setAttribute("href","<?= $extended_family_css ?>");
  document.head.appendChild(newSheet);

  // filter: reset filter values
  sessionStorage.removeItem('sexFilterValue');
  sessionStorage.removeItem('aliveFilterValue');

  // filter: initial status: show only "all"
  document.querySelectorAll('.hh-extended-filter[data-filter-value]:not([data-filter-value="all"]), .hh-extended-family-filter-actions[data-filter-value]:not([data-filter-value="all"])').forEach((element) => {
      element.classList.add('d-none');
  });

  document.querySelectorAll('.hh-extended-family-reset-family-parts').forEach((button) => {
      button.addEventListener('click', () => {
          const form = button.closest('form');
          form?.querySelectorAll("input[name='family_parts[]']").forEach((input) => {
              input.checked = input.dataset.defaultEnabled === '1';
          });
      });
  });

  // filter click function
  document.querySelectorAll('.hh-extended-filter-button').forEach((checkbox) => {
      checkbox.addEventListener('click', () => {
      const buttonGroup = checkbox.closest('.btn-group');
      const siblings = buttonGroup?.querySelectorAll("input[type='checkbox']") ?? [];
      const checked = checkbox.checked;

      // Entferne `checked` und `active` von allen benachbarten Buttons
      siblings.forEach((sibling) => { sibling.checked = false; });
      buttonGroup?.querySelectorAll('label.btn').forEach((label) => label.classList.remove('active'));

      // Wende `checked` und `active` nur auf aktuellen Button an
      if (checked) {
          checkbox.checked = true;
          checkbox.closest('label')?.classList.add('active'); // Wichtig für Bootstrap
      } else {
          checkbox.closest('label')?.classList.remove('active');
      }

      // Speichere die Filterwerte
      const filterType = checkbox.dataset.filterType;

      if (filterType === "sex") {
          sessionStorage.setItem(
              "sexFilterValue",
              checked ? checkbox.dataset.filterValue : ''
          );
      } else if (filterType === "alive") {
          sessionStorage.setItem(
              "aliveFilterValue",
              checked ? checkbox.dataset.filterValue : ''
          );
      }

      // Hole die aktuellen Filterwerte aus dem sessionStorage
      const sexFilterValue = sessionStorage.getItem('sexFilterValue') || '';
      const aliveFilterValue = sessionStorage.getItem('aliveFilterValue') || '';

      // Kombiniere die beiden Filterwerte
      let filterValue = sexFilterValue + aliveFilterValue;

      // Fallback: Wenn kein Filter aktiv ist, zeige "all"
      if (filterValue === "") {
          filterValue = 'all';
      }

      // Alle Blöcke unsichtbar machen
      document.querySelectorAll('.hh-extended-filter, .hh-extended-family-filter-actions').forEach((element) => element.classList.add('d-none'));

      // Zeige den passenden Block
      document.querySelectorAll(`[data-filter-value="${CSS.escape(filterValue)}"]`).forEach((element) => element.classList.remove('d-none'));

      // console.log("hh-extended-filter[data-filter-value='"+filterValue+"']");
      });
  });
</script>
<?php View::endpush() ?>
