<?php View::push('javascript') ?>
<script>
  const defaultFamilyPartOrder = <?= json_encode($default_family_part_order) ?>;

  document.querySelectorAll('.wt-table-menu td.move').forEach((cell) => {
      cell.addEventListener('click', (event) => {
          event.preventDefault();
          const row = cell.closest('tr');

          if (!row) {
              return;
          }

          if (cell.classList.contains('up')) {
              row.previousElementSibling?.before(row);
          } else {
              row.nextElementSibling?.after(row);
          }
      });
  });

  document.querySelectorAll('.hh-extended-family-select-all').forEach((button) => {
      button.addEventListener('click', () => {
          document.querySelectorAll('.hh-extended-family-part-status').forEach((input) => { input.checked = true; });
          syncFamilyPartAvailability();
      });
  });

  document.querySelectorAll('.hh-extended-family-select-none').forEach((button) => {
      button.addEventListener('click', () => {
          document.querySelectorAll('.hh-extended-family-part-status').forEach((input) => { input.checked = false; });
          syncFamilyPartAvailability();
      });
  });

  document.querySelectorAll('.hh-extended-family-deselect-non-blood').forEach((button) => {
      button.addEventListener('click', () => {
          document.querySelectorAll('.hh-extended-family-part-status[data-non-blood="1"]').forEach((input) => { input.checked = false; });
          syncFamilyPartAvailability();
      });
  });

  document.querySelectorAll('.hh-extended-family-reset-order').forEach((button) => {
      button.addEventListener('click', () => {
          const tableBody = document.querySelector('.wt-table-menu tbody');

          if (!tableBody) {
              return;
          }

          defaultFamilyPartOrder.forEach((familyPart) => {
              const input = Array.from(tableBody.querySelectorAll('input[name="order[]"]'))
                  .find((candidate) => candidate.value === familyPart);
              const row = input?.closest('tr');

              if (row) {
                  tableBody.append(row);
              }
          });
      });
  });

  document.querySelectorAll('.hh-extended-family-apply-degree').forEach((button) => {
      button.addEventListener('click', () => {
          const degreeInput = document.querySelector('.hh-extended-family-degree-limit');
          const degreeLimit = Number.parseInt(degreeInput?.value ?? '', 10);

          if (Number.isNaN(degreeLimit)) {
              document.querySelectorAll('.hh-extended-family-part-status').forEach((input) => { input.checked = true; });
              syncFamilyPartAvailability();
              return;
          }

          document.querySelectorAll('.hh-extended-family-part-status').forEach((input) => {
              const degree = Number.parseInt(input.dataset.degree ?? '', 10);

              if (!Number.isNaN(degree)) {
                  input.checked = degree <= degreeLimit;
              }
          });
          syncFamilyPartAvailability();
      });
  });

  function syncFamilyPartAvailability() {
      document.querySelectorAll('.hh-extended-family-part-status').forEach((status) => {
          const familyPart = status.dataset.familyPart;
          const selectable = document.querySelector('.hh-extended-family-part-selectable[data-family-part="' + CSS.escape(familyPart) + '"]');

          if (selectable && status.checked) {
              selectable.checked = true;
          }

          status.disabled = !selectable?.checked;
      });
  }

  document.querySelectorAll('.hh-extended-family-part-status, .hh-extended-family-part-selectable').forEach((input) => {
      input.addEventListener('change', syncFamilyPartAvailability);
  });
  syncFamilyPartAvailability();

  function updateDependencyWarnings() {
      const summaryDisabled = document.querySelector('input[name="show_summary"]:checked')?.value === '1';
      const statisticsEnabled = document.querySelector('input[name="show_summary_statistics"]:checked')?.value === '0';
      const statisticsDisabled = !statisticsEnabled;
      const degreeTableEnabled = document.querySelector('input[name="show_degree_table"]:checked')?.value === '0';
      const emptyPartsCollectedAtSummary = document.querySelector('[name="show_empty_block"]')?.value === '1';
      const relationshipMouseoverEnabled = document.querySelector('input[name="show_relationship_to_proband"]:checked')?.value === '0';
      const relationshipNamesAvailable = <?= $relationship_names_available ? 'true' : 'false' ?>;

      document.querySelectorAll('.hh-extended-family-summary-statistics-warning').forEach((element) => element.classList.toggle('d-none', !(summaryDisabled && statisticsEnabled)));
      document.querySelectorAll('.hh-extended-family-summary-table-columns-warning').forEach((element) => element.classList.toggle('d-none', !(summaryDisabled || statisticsDisabled)));
      document.querySelectorAll('.hh-extended-family-degree-table-warning').forEach((element) => element.classList.toggle('d-none', !(summaryDisabled && degreeTableEnabled)));
      document.querySelectorAll('.hh-extended-family-empty-summary-warning').forEach((element) => element.classList.toggle('d-none', !(summaryDisabled && emptyPartsCollectedAtSummary)));
      document.querySelectorAll('.hh-extended-family-relationship-warning').forEach((element) => element.classList.toggle('d-none', !(!relationshipNamesAvailable && relationshipMouseoverEnabled)));
  }

  document.querySelectorAll('input[name="show_summary"], input[name="show_summary_statistics"], input[name="show_degree_table"], input[name="show_relationship_to_proband"], [name="show_empty_block"]').forEach((input) => {
      input.addEventListener('change', updateDependencyWarnings);
  });
  updateDependencyWarnings();
</script>
